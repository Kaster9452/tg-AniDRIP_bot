# ============================================================
# AniDRIP предложка-бот — пример настроек для нового владельца
# Скопируйте этот файл в .env и заполните своими значениями.
# (На Render переменные задаются в разделе Environment — см. GUIDE.md)
# ============================================================

# ── Токен бота от @BotFather, например: 123456789:AAH... ──
BOT_TOKEN=

# ── ID группы админов (вид -100...). Узнать: /id в этой группе ──
ADMIN_GROUP_ID=

# ── ID канала, куда публикуются посты (вид -100...) ──
CHANNEL_ID=

# ── Строка подключения к PostgreSQL (Neon / Supabase / свой сервер) ──
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Часовой пояс (по умолчанию Europe/Moscow) ──
TIMEZONE=Europe/Moscow

# ── Адрес вашего сервиса (https), для открытия панели как Mini App ──
WEBAPP_URL=https://ваш-сервис.onrender.com

# ── Короткое имя Mini App из BotFather (для запуска панели из группы) ──
WEBAPP_SHORT_NAME=panel

# ── Название бота, которое видно в панели и справке админа ──
BOT_NAME=МойКанал

# ── Порт для локального запуска (на Render задаётся автоматически) ──
PORT=10000
